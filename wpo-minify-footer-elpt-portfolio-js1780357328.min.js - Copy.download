function initFixedLayoutCache($containerElement){if(fixedLayoutInitialized){return}
var $allItems=$containerElement.children('.portfolio-item-wrapper');fixedLayoutOriginalOrder=[];$allItems.each(function(index){fixedLayoutOriginalOrder.push({element:this,originalIndex:index})});fixedLayoutInitialized=!0;fixedLayoutLog('Cache initialized with '+fixedLayoutOriginalOrder.length+' items')}
