function getFilterSelector(){var selector=itemSelector;if(currentFilter!='*'){selector+=currentFilter}
return selector}
function goToPage(n){var $gridBuilder=jQuery('.elpt-portfolio-content-packery.elpt-portfolio-grid-builder');var isFixedLayout=$gridBuilder.length>0&&$gridBuilder.hasClass('elpt-fixed-layout-mode');currentPage=n;var selector=getFilterSelector();selector+='['+pageAtribute+'="'+currentPage+'"]';if(isFixedLayout){fixedLayoutEventId++;var currentEventId=fixedLayoutEventId;fixedLayoutLog('goToPage('+n+') START - eventId: '+currentEventId+' (previous operations cancelled)');initFixedLayoutCache($container);resetFixedLayoutPositions($container);applyFixedLayoutPositionsForCurrentFilter($container,selector);changeFilter(selector);$container.isotope('layout');fixedLayoutLog('goToPage('+n+') - layout triggered, eventId: '+currentEventId);$container.isotope('once','arrangeComplete',function(){if(currentEventId!==fixedLayoutEventId){fixedLayoutLog('arrangeComplete SKIPPED - outdated eventId: '+currentEventId+', current: '+fixedLayoutEventId);return}
