fixedLayoutLog('goToPage('+n+') arrangeComplete - eventId: '+currentEventId);applyFixedLayoutPositionsFromIsotope($container);fixedLayoutCompletedEventId=currentEventId;setTimeout(function(){if(currentEventId!==fixedLayoutEventId){fixedLayoutLog('setTimeout SKIPPED - outdated eventId: '+currentEventId);return}
