function scrollToGridTop($containerElement){if(!$containerElement||$containerElement.length===0){return}
var gridTop=$containerElement.offset().top;var margin=100;var targetScroll=Math.max(0,gridTop-margin);var currentScroll=jQuery(window).scrollTop();var scrollData={target:targetScroll,gridTop:gridTop,margin:margin,container:$containerElement};jQuery(document).trigger('powerfolio:scroll_target',[scrollData]);targetScroll=scrollData.target;if(currentScroll>targetScroll){window.scrollTo(0,targetScroll);fixedLayoutLog('Scrolled to: '+targetScroll+'px')}}
